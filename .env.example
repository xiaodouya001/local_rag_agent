# RAG Agent 配置文件示例
# 复制此文件为 .env 并填入你的配置
# 所有配置项使用 RAG_ 前缀，并在其后添加具体类别名称
# 格式：RAG_{类别}_{配置项}（如 RAG_LLM_API_KEY）

# 必需配置
RAG_LLM_API_KEY=your-api-key-here

# LLM API 配置（可选）
# RAG_LLM_API_BASE=https://api.deepseek.com/v1

# LLM 参数（可选）
# RAG_LLM_TEMPERATURE=0.7
# RAG_LLM_MAX_TOKENS=2000
# RAG_LLM_TIMEOUT=60

# LLM 重试配置（可选）
# RAG_LLM_MAX_RETRIES=3
# RAG_LLM_RETRY_WAIT_BASE=2

# 模型配置（可选）
# RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
# RAG_LLM_MODEL=deepseek-chat

# 文档分块配置（可选）
# RAG_DOCUMENT_CHUNK_SIZE=1000
# RAG_DOCUMENT_CHUNK_OVERLAP=200

# 检索配置（可选）
# RAG_RETRIEVER_DEFAULT_K=10

# 向量存储配置（可选）
# RAG_VECTORSTORE_PERSIST_DIRECTORY=./chroma_db

# 调试配置（不属于 RAGConfig，由其他模块读取）
# LOG_LEVEL=INFO
# ENABLE_API_DEBUG=false
# ENABLE_SDK_DEBUG=false


# HuggingFace 配置
#HF_HUB_DOWNLOAD_TIMEOUT_SECONDS=300
#HF_HUB_DOWNLOAD_RETRIES=5
